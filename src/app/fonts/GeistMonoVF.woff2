<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GeistMonoVF Font Example</title>
  <style>
    @font-face {
      font-family: 'GeistMonoVF';
      src: url('GeistMonoVF (1).woff') format('woff');
      font-weight: normal;
      font-style: normal;
    }

    body {
      font-family: 'GeistMonoVF', monospace;
      background-color: #f0f0f0;
      color: #333;
      padding: 40px;
    }

    h1 {
      font-size: 2.5rem;
    }

    p {
      font-size: 1.2rem;
    }

    code {
      display: block;
      background-color: #222;
      color: #0f0;
      padding: 10px;
      border-radius: 8px;
      margin-top: 20px;
      font-family: 'GeistMonoVF', monospace;
    }
  </style>
</head>
<body>
  <h1>Using GeistMonoVF Font</h1>
  <p>This is a demo showing the GeistMonoVF font in action.</p>
  <code>
    const hello = 'world';<br>
    console.log(hello);
  </code>
</body>
</html>
